  "components": {
    "securitySchemes": {
      "BearerAuth": {
        "type": "http",
        "scheme": "bearer",
        "bearerFormat": "JWT",
        "description": "JWT Access Token을 Bearer 스킴으로 전달합니다. 로그인(`POST /api/auth/login`) 후 발급받은 `accessToken` 값을 사용합니다.\n\n**형식**: `Authorization: Bearer {accessToken}`\n\n**만료 시간**: 1시간 (1h)\n\n**저장 방식**: 클라이언트는 Zustand 메모리(authStore)에 저장합니다."
      }
    },
    "parameters": {
      "TodoId": {
        "name": "id",
        "in": "path",
        "required": true,
        "description": "할일 고유 식별자 (UUID)",
        "schema": {
          "type": "string",
          "format": "uuid"
        },
        "example": "f1e2d3c4-b5a6-7890-1234-567890abcdef"
      },
      "CategoryId": {
        "name": "id",
        "in": "path",
        "required": true,
        "description": "카테고리 고유 식별자 (UUID)",
        "schema": {
          "type": "string",
          "format": "uuid"
        },
        "example": "a1b2c3d4-e5f6-7890-abcd-ef1234567890"
      }
    },
    "schemas": {
      "User": {
        "type": "object",
        "description": "사용자 정보 스키마. 비밀번호(password)는 응답에서 항상 제외됩니다.",
        "required": ["id", "email", "name", "createdAt", "updatedAt"],
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid",
            "description": "사용자 고유 식별자 (PK)",
            "example": "550b280a-d66d-46c2-9f34-ac3b12345678"
          },
          "email": {
            "type": "string",
            "format": "email",
            "maxLength": 255,
            "description": "로그인 이메일. 변경 불가(BR-12).",
            "example": "minjun@example.com"
          },
          "name": {
            "type": "string",
            "maxLength": 100,
            "description": "사용자 이름",
            "example": "김민준"
          },
          "createdAt": {
            "type": "string",
            "format": "date-time",
            "description": "가입일시 (ISO 8601)",
            "example": "2026-05-13T09:00:00.000Z"
          },
          "updatedAt": {
            "type": "string",
            "format": "date-time",
            "description": "정보 수정일시 (ISO 8601)",
            "example": "2026-05-13T09:00:00.000Z"
          }
        }
      },
      "Category": {
        "type": "object",
        "description": "카테고리 정보 스키마. userId가 null이면 시스템 기본 카테고리(BR-07), null이 아니면 사용자 정의 카테고리(BR-09).",
        "required": ["id", "name", "isDefault", "createdAt"],
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid",
            "description": "카테고리 고유 식별자 (PK)",
            "example": "a1b2c3d4-e5f6-7890-abcd-ef1234567890"
          },
          "userId": {
            "type": "string",
            "format": "uuid",
            "nullable": true,
            "description": "소유자 ID. null이면 시스템 기본 카테고리(BR-07), null이 아니면 사용자 정의 카테고리.",
            "example": "550b280a-d66d-46c2-9f34-ac3b12345678"
          },
          "name": {
            "type": "string",
            "maxLength": 100,
            "description": "카테고리명",
            "example": "사이드프로젝트"
          },
          "isDefault": {
            "type": "boolean",
            "description": "기본 카테고리 여부. true이면 userId는 항상 null.",
            "example": false
          },
          "createdAt": {
            "type": "string",
            "format": "date-time",
            "description": "생성일시 (ISO 8601)",
            "example": "2026-05-13T10:00:00.000Z"
          }
        }
      },
      "Todo": {
        "type": "object",
        "description": "할일 정보 스키마.",
        "required": ["id", "userId", "categoryId", "title", "isCompleted", "createdAt", "updatedAt"],
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid",
            "description": "할일 고유 식별자 (PK)",
            "example": "f1e2d3c4-b5a6-7890-1234-567890abcdef"
          },
          "userId": {
            "type": "string",
            "format": "uuid",
            "description": "소유자 ID (BR-03: 사용자는 자신의 할일만 접근 가능)",
            "example": "550b280a-d66d-46c2-9f34-ac3b12345678"
          },
          "categoryId": {
            "type": "string",
            "format": "uuid",
            "description": "카테고리 ID (BR-04: 할일 등록 시 카테고리 필수)",
            "example": "a1b2c3d4-e5f6-7890-abcd-ef1234567890"
          },
          "title": {
            "type": "string",
            "maxLength": 255,
            "description": "할일 제목",
            "example": "팀 주간 업무 보고서 작성"
          },
          "description": {
            "type": "string",
            "nullable": true,
            "description": "할일 설명 (선택 입력, BR-05)",
            "example": "매주 금요일 오후 5시 마감"
          },
          "dueDate": {
            "type": "string",
            "format": "date",
            "nullable": true,
            "description": "종료 예정일 (선택 입력, BR-05, ISO 8601 date 형식: YYYY-MM-DD)",
            "example": "2026-05-17"
          },
          "isCompleted": {
            "type": "boolean",
            "description": "완료 여부. 기본값 false. 완료 후 취소 가능(BR-06).",
            "example": false
          },
          "createdAt": {
            "type": "string",
            "format": "date-time",
            "description": "등록일시 (ISO 8601)",
            "example": "2026-05-13T09:30:00.000Z"
          },
          "updatedAt": {
            "type": "string",
            "format": "date-time",
            "description": "수정일시 (ISO 8601)",
            "example": "2026-05-13T09:30:00.000Z"
          }
        }
      },
      "RegisterRequest": {
        "type": "object",
        "description": "회원가입 요청 스키마 (UC-01)",
        "required": ["email", "password", "name"],
        "properties": {
          "email": {
            "type": "string",
            "format": "email",
            "maxLength": 255,
            "description": "가입할 이메일 주소. 중복 불가.",
            "example": "minjun@example.com"
          },
          "password": {
            "type": "string",
            "minLength": 8,
            "description": "비밀번호. 최소 8자 이상 필수. 서버에서 bcrypt(saltRounds:12)로 해시 저장.",
            "example": "securePass1!"
          },
          "name": {
            "type": "string",
            "maxLength": 100,
            "description": "사용자 이름",
            "example": "김민준"
          }
        }
      },
      "LoginRequest": {
        "type": "object",
        "description": "로그인 요청 스키마 (UC-02)",
        "required": ["email", "password"],
        "properties": {
          "email": {
            "type": "string",
            "format": "email",
            "description": "가입된 이메일 주소",
            "example": "minjun@example.com"
          },
          "password": {
            "type": "string",
            "description": "비밀번호",
            "example": "securePass1!"
          }
        }
      },
      "AuthResponse": {
        "type": "object",
        "description": "인증 성공 응답 스키마 (회원가입/로그인 공통). accessToken의 만료 시간은 1시간(1h)입니다.",
        "required": ["accessToken", "user"],
        "properties": {
          "accessToken": {
            "type": "string",
            "description": "JWT Access Token. 만료 시간 1h. 인증이 필요한 모든 API 요청 시 Authorization 헤더에 포함해야 합니다.",
            "example": "eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJ1c2VySWQiOiI1NTBiMjgwYS1kNjZkLTQ2YzItOWYzNC1hYzNiMTIzNDU2NzgiLCJpYXQiOjE3MTU1NjgwMDAsImV4cCI6MTcxNTU3MTYwMH0.example"
          },
          "user": {
            "$ref": "#/components/schemas/User"
          }
        }
      },
      "UpdateUserRequest": {
        "type": "object",
        "description": "내 정보 수정 요청 스키마 (UC-03). 이메일 수정은 BR-12에 의해 불가합니다. name과 password 중 최소 하나는 포함해야 합니다.",
        "minProperties": 1,
        "properties": {
          "name": {
            "type": "string",
            "maxLength": 100,
            "description": "변경할 이름 (선택)",
            "example": "민준킴"
          },
          "password": {
            "type": "string",
            "minLength": 8,
            "description": "변경할 비밀번호 (선택). 최소 8자 이상 필수.",
            "example": "newPassword123!"
          }
        }
      },
      "CreateTodoRequest": {
        "type": "object",
        "description": "할일 등록 요청 스키마 (UC-04). 등록 후 isCompleted는 항상 false로 초기화됩니다.",
        "required": ["title", "categoryId"],
        "properties": {
          "title": {
            "type": "string",
            "maxLength": 255,
            "description": "할일 제목 (필수, BR-04)",
            "example": "팀 주간 업무 보고서 작성"
          },
          "categoryId": {
            "type": "string",
            "format": "uuid",
            "description": "카테고리 ID (필수, BR-04). 존재하지 않는 categoryId 지정 시 400 반환.",
            "example": "a1b2c3d4-e5f6-7890-abcd-ef1234567890"
          },
          "description": {
            "type": "string",
            "description": "할일 설명 (선택, BR-05)",
            "example": "매주 금요일 오후 5시 마감"
          },
          "dueDate": {
            "type": "string",
            "format": "date",
            "description": "종료 예정일 (선택, BR-05, YYYY-MM-DD)",
            "example": "2026-05-17"
          }
        }
      },
      "UpdateTodoRequest": {
        "type": "object",
        "description": "할일 수정 요청 스키마 (UC-05). 포함된 필드만 업데이트됩니다. 완료 상태에서도 수정 가능(BR-06). 최소 하나의 필드를 포함해야 합니다.",
        "minProperties": 1,
        "properties": {
          "title": {
            "type": "string",
            "maxLength": 255,
            "description": "변경할 할일 제목 (선택)",
            "example": "주간 보고서 작성 (수정)"
          },
          "categoryId": {
            "type": "string",
            "format": "uuid",
            "description": "변경할 카테고리 ID (선택). 존재하지 않는 categoryId 지정 시 400 반환.",
            "example": "b2c3d4e5-f6a7-8901-bcde-f12345678901"
          },
          "description": {
            "type": "string",
            "nullable": true,
            "description": "변경할 할일 설명 (선택). null 전달 시 설명 제거.",
            "example": "다음 주 월요일 오전까지로 변경"
          },
          "dueDate": {
            "type": "string",
            "format": "date",
            "nullable": true,
            "description": "변경할 종료 예정일 (선택, YYYY-MM-DD). null 전달 시 마감일 제거.",
            "example": "2026-05-18"
          }
        }
      },
      "CreateCategoryRequest": {
        "type": "object",
        "description": "사용자 정의 카테고리 추가 요청 스키마 (UC-09)",
        "required": ["name"],
        "properties": {
          "name": {
            "type": "string",
            "maxLength": 100,
            "description": "카테고리명 (필수). 동일 사용자 내 중복 불가.",
            "example": "사이드프로젝트"
          }
        }
      },
      "ErrorResponse": {
        "type": "object",
        "description": "표준 에러 응답 스키마. 모든 에러 응답은 이 형식을 따릅니다.",
        "required": ["status", "message"],
        "properties": {
          "status": {
            "type": "integer",
            "description": "HTTP 상태 코드",
            "example": 400
          },
          "message": {
            "type": "string",
            "description": "에러 메시지 (사용자에게 표시 가능한 내용)",
            "example": "제목은 필수입니다."
          }
        }
      }
    },
    "responses": {
      "BadRequest": {
        "description": "잘못된 요청 (유효성 검사 실패). 필수값 누락, 형식 오류, 비밀번호 8자 미만, 존재하지 않는 categoryId 등.",
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/ErrorResponse"
            },
            "examples": {
              "필수값 누락": {
                "summary": "카테고리 누락 (SCN-17)",
                "value": {
                  "status": 400,
                  "message": "카테고리를 선택해 주세요."
                }
              },
              "비밀번호 정책 위반": {
                "summary": "비밀번호 8자 미만 (SCN-13)",
                "value": {
                  "status": 400,
                  "message": "비밀번호는 최소 8자 이상이어야 합니다."
                }
              },
              "이메일 형식 오류": {
                "summary": "이메일 형식 불일치",
                "value": {
                  "status": 400,
                  "message": "유효한 이메일 형식이 아닙니다."
                }
              },
              "존재하지 않는 카테고리": {
                "summary": "categoryId가 존재하지 않음",
                "value": {
                  "status": 400,
                  "message": "존재하지 않는 카테고리입니다."
                }
              }
            }
          }
        }
      },
      "Unauthorized": {
        "description": "인증 실패. JWT 토큰이 없거나 유효하지 않거나 만료되었습니다. 또는 이메일/비밀번호 불일치.",
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/ErrorResponse"
            },
            "examples": {
              "미인증 요청": {
                "summary": "Authorization 헤더 없음 또는 JWT 만료 (SCN-16, SCN-24)",
                "value": {
                  "status": 401,
                  "message": "인증이 필요합니다."
                }
              },
              "로그인 실패": {
                "summary": "이메일 없음 또는 비밀번호 불일치 (SCN-14, SCN-15)",
                "value": {
                  "status": 401,
                  "message": "이메일 또는 비밀번호가 올바르지 않습니다."
                }
              }
            }
          }
        }
      },
      "Forbidden": {
        "description": "접근 권한 없음. 타인 리소스 접근 시도, 또는 기본 카테고리 삭제 시도.",
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/ErrorResponse"
            },
            "examples": {
              "타인 할일 접근": {
                "summary": "타인 소유 할일 수정/삭제/완료 시도 (SCN-18, SCN-20)",
                "value": {
                  "status": 403,
                  "message": "접근 권한이 없습니다."
                }
              },
              "기본 카테고리 삭제 시도": {
                "summary": "isDefault=true인 카테고리 삭제 시도 (SCN-23)",
                "value": {
                  "status": 403,
                  "message": "기본 카테고리는 삭제할 수 없습니다."
                }
              }
            }
          }
        }
      },
      "NotFound": {
        "description": "리소스를 찾을 수 없음. 존재하지 않는 할일 또는 카테고리 ID.",
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/ErrorResponse"
            },
            "examples": {
              "존재하지 않는 할일": {
                "summary": "삭제됐거나 없는 할일 ID (SCN-19)",
                "value": {
                  "status": 404,
                  "message": "존재하지 않는 할일입니다."
                }
              },
              "존재하지 않는 카테고리": {
                "summary": "없는 카테고리 ID",
                "value": {
                  "status": 404,
                  "message": "존재하지 않는 카테고리입니다."
                }
              }
            }
          }
        }
      },
      "Conflict": {
        "description": "충돌. 중복 이메일, 중복 카테고리명, 또는 연결된 할일이 있는 카테고리 삭제 시도.",
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/ErrorResponse"
            },
            "examples": {
              "중복 이메일": {
                "summary": "이미 가입된 이메일 (SCN-12)",
                "value": {
                  "status": 409,
                  "message": "이미 사용 중인 이메일입니다."
                }
              },
              "중복 카테고리명": {
                "summary": "동일 사용자 내 중복 카테고리명 (SCN-21)",
                "value": {
                  "status": 409,
                  "message": "이미 존재하는 카테고리명입니다."
                }
              },
              "할일 연결된 카테고리 삭제": {
                "summary": "할일이 연결된 카테고리 삭제 시도 (SCN-22, BR-10)",
                "value": {
                  "status": 409,
                  "message": "해당 카테고리에 연결된 할일이 있어 삭제할 수 없습니다."
                }
              }
            }
          }
        }
      }
    }
  }
